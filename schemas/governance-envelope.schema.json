{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pool-private one-use governance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "witness_id", "state", "authority_digest", "office_id",
    "generation", "runtime_version", "project_path", "project_volume",
    "project_file_id", "mission", "route", "task_digest", "request_digest",
    "target", "workflow_digest", "run_id", "producer_artifacts", "covenant",
    "requirements_evidence_digest", "ao2", "created_at", "expires_at",
    "payload_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "witness_id": {"type": "string", "pattern": "^witness-[0-9a-f]{32}$"},
    "state": {"const": "ready"},
    "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "office_id": {"enum": ["O1", "O2", "O3", "O4", "O5"]},
    "generation": {"type": "integer", "minimum": 1},
    "runtime_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
    "project_path": {"type": "string", "minLength": 1, "maxLength": 32767},
    "project_volume": {"type": "integer", "minimum": 0},
    "project_file_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "objective_digest", "status", "current_route"],
      "properties": {
        "mission_id": {"type": "string", "pattern": "^mission-[0-9a-f]{16}$"},
        "objective_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1, "maxLength": 64},
        "current_route": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1, "maxLength": 64}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_digest", "route", "atlas_required", "execution_candidate"],
      "properties": {
        "decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "route": {"enum": ["ao-blueprint", "ao-atlas", "ao-forge", "blocked"]},
        "atlas_required": {"type": "boolean"},
        "execution_candidate": {"type": "boolean"}
      }
    },
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "volume", "file_id"],
      "properties": {
        "canonical_path": {"type": "string", "minLength": 1, "maxLength": 32767},
        "volume": {"type": "integer", "minimum": 0},
        "file_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{16}$"},
    "producer_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ao-blueprint", "ao-atlas", "ao-forge", "ao-covenant"],
      "properties": {
        "ao-blueprint": {
          "type": "object", "additionalProperties": false,
          "required": ["commit", "asset", "binary_sha256", "command_contract", "artifact_sha256"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "asset": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
            "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "command_contract": {"type": "string", "minLength": 1, "maxLength": 512},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "ao-atlas": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["commit", "asset", "binary_sha256", "command_contract", "artifact_sha256"],
              "properties": {
                "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "asset": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
                "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "command_contract": {"type": "string", "minLength": 1, "maxLength": 512},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            {"type": "null"}
          ]
        },
        "ao-forge": {
          "type": "object", "additionalProperties": false,
          "required": ["commit", "asset", "binary_sha256", "command_contract", "artifact_sha256"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "asset": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
            "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "command_contract": {"type": "string", "minLength": 1, "maxLength": 512},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "ao-covenant": {
          "type": "object", "additionalProperties": false,
          "required": ["commit", "asset", "binary_sha256", "command_contract", "artifact_sha256"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "asset": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 128},
            "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "command_contract": {"type": "string", "minLength": 1, "maxLength": 512},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "covenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "scope", "expires_at", "revoked"],
      "properties": {
        "decision": {"const": "authorized"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 32767},
        "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "revoked": {"const": false}
      }
    },
    "requirements_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ao2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit", "asset", "sha256"],
      "properties": {
        "name": {"const": "ao2"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "asset": {"const": "ao2.exe"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
