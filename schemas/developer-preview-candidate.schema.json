{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-office-pool/schemas/developer-preview-candidate.schema.json",
  "title": "AO Office Pool private developer preview candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "label", "architecture", "source", "component_lock_sha256", "archive", "components", "metadata", "installer", "immutable", "authority"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "repository", "commit", "asset", "license", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/uesugitorachiyo/[A-Za-z0-9._-]+\\.git$"},
        "commit": {"$ref": "#/$defs/commit"},
        "asset": {"type": "string", "pattern": "^[^/\\\\]+\\.exe$"},
        "license": {"const": "Apache-2.0"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^windows-ai-bootstrap-v[0-9]{2}-[0-9a-f]{7}$"},
    "label": {"const": "developer-preview"},
    "architecture": {"const": "windows-x86_64"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "clean"],
      "properties": {"commit": {"$ref": "#/$defs/commit"}, "clean": {"const": true}}
    },
    "component_lock_sha256": {"$ref": "#/$defs/sha256"},
    "archive": {"allOf": [{"$ref": "#/$defs/identity"}], "properties": {"name": {"const": "ao-office-pool-developer-preview.zip"}}},
    "components": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/component"}},
    "metadata": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/identity"}},
    "installer": {
      "const": {
        "acquire": "packaging/Get-AOOfficePoolRelease.ps1",
        "ai_runbook": "docs/AI_OPERATOR_RUNBOOK.md",
        "install": "packaging/Install-AOOfficePool.ps1",
        "read_first": "README-FIRST.md",
        "uninstall": "packaging/Uninstall-AOOfficePool.ps1",
        "verify": "packaging/Verify-AOOfficePool.ps1"
      }
    },
    "immutable": {"const": true},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_authorized", "release_visibility", "tag_target"],
      "properties": {
        "publication_authorized": {"const": false},
        "release_visibility": {"const": "private"},
        "tag_target": {"$ref": "#/$defs/commit"}
      }
    }
  }
}
